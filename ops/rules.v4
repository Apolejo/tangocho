# /etc/iptables/rules.v4 (docs/ORACLE.md): the host firewall, restored at boot by netfilter-persistent
# before Docker starts. Only the INPUT allowlist: Docker builds its own chains, nat and raw rules when it
# starts, and the game servers' published ports go through FORWARD, never INPUT. Never run
# `netfilter-persistent save` (it would snapshot Docker's chains into this file) or `reload` (it would
# flush them). Oracle's security list is the outer layer and must open the same ports.
*filter
:INPUT ACCEPT [0:0]
:FORWARD DROP [0:0]
:OUTPUT ACCEPT [0:0]
-A INPUT -i lo -j ACCEPT
-A INPUT -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT
-A INPUT -p icmp -j ACCEPT
-A INPUT -p udp -m udp --sport 123 -j ACCEPT
-A INPUT -p tcp -m tcp --dport 22 -j ACCEPT
-A INPUT -p tcp -m multiport --dports 80,443 -j ACCEPT
-A INPUT -j REJECT --reject-with icmp-host-prohibited
COMMIT
