# /etc/caddy/Caddyfile (docs/ORACLE.md): the mirror of the app on the Oracle VM, the same build as
# GitHub Pages at the same path. Caddy gets and renews the certificates itself and keeps no access log.
# Applied by hand: caddy validate, then systemctl reload caddy.
{
	servers {
		# no HTTP/3: Oracle's security list keeps UDP 443 closed
		protocols h1 h2
	}
}

apolejo.dev {
	# gzip only, like GitHub Pages: Safari's zstd support is recent (26.3) and partial
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
	}

	# temporary: the bare domain stays free for something else later
	redir / /tangocho/ 302
	redir /tangocho /tangocho/ 308

	# M12: the sync service goes under /api/; until then the 404 below answers it

	handle_path /tangocho/* {
		# a symlink to releases/<sha>/, switched by tangocho-deploy (ops/tangocho-deploy.sh)
		root * /srv/tangocho/current

		# index.html, sw.js, the manifest, the icons and any 404: always revalidated, so a deploy shows at once
		header Cache-Control no-cache
		# named by their content hash, so they never change; only when found, though: a 404 kept
		# for a year would break the next release in that browser
		@hashed path /assets/*
		header @hashed {
			Cache-Control "public, max-age=31536000, immutable"
			match status 2xx 304
		}
		header /manifest.webmanifest Content-Type application/manifest+json

		file_server
	}

	handle {
		error 404
	}

	# Errors answer with a typed page. An empty 404 has no Content-Type, and with nosniff Safari
	# offers to download it as a file named after the address (a typo, /tanocho, did).
	handle_errors 404 {
		header Cache-Control no-cache
		header Content-Type "text/html; charset=utf-8"
		respond <<HTML
			<!doctype html>
			<html lang="en">
			<meta charset="utf-8">
			<meta name="viewport" content="width=device-width, initial-scale=1">
			<meta name="color-scheme" content="light dark">
			<title>Not found · Tangochō</title>
			<body style="margin: 0; padding: 3rem 1.25rem; font: 1.125rem/1.6 system-ui, sans-serif; background: light-dark(#f6f1e7, #171c27); color: light-dark(#24211d, #ece5d8)">
			<main style="max-width: 32rem; margin: 0 auto">
			<p><span lang="ja">単語帳</span> Tangochō</p>
			<h1 style="font-size: 1.5rem">Nothing at this address</h1>
			<p>The app is at <a href="/tangocho/" style="color: inherit">apolejo.dev/tangocho/</a>.</p>
			<p lang="es">No hay nada en esta dirección. La app está en <a href="/tangocho/" style="color: inherit">apolejo.dev/tangocho/</a>.</p>
			</main>
			</body>
			</html>
			HTML 404
	}
	handle_errors {
		header Cache-Control no-cache
		header Content-Type "text/plain; charset=utf-8"
		respond "{err.status_code} {err.status_text}" {err.status_code}
	}
}

www.apolejo.dev {
	redir https://apolejo.dev{uri} 308
}
